<?xml version='1.0' encoding='utf-8'?>

<lccdd>

    <define>
        <constant name="ECALWidth" value="229.2*mm" />
        <constant name="ECALHeight" value="229.2*mm" />
        <constant name="ECALLayerDepth" value="3.0*mm" />
        <constant name="NLayersECAL" value="150" />

        <constant name="ECALPosX" value="0.0*mm" />
        <constant name="ECALPosY" value="0.0*mm" />
        <constant name="ECALPosZ" value="0.0*mm" />
    </define>

    <detectors>
        <detector id="NA64Ecal:ID" name="NA64Ecal" type="NA64ECal_base" readout="NA64EcalHits" vis="NA64Ecal">
            <dimensions x="ECALWidth" y="ECALHeight" z="ECALLayerDepth*NLayersECAL"/>
            <position x="ECALPosX" y="ECALPosY" z="ECALPosZ"/>
        </detector>
    </detectors>

    <readouts>
        <readout name="NA64EcalHits">
        <id>TBD</id>
        </readout>
    </readouts>

</lccdd>
