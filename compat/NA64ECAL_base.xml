<?xml version='1.0' encoding='utf-8'?>

<lccdd>

    <define>
        <constant name="ECALWidth" value="229.2*mm" />
        <constant name="ECALHeight" value="229.2*mm" />
        <constant name="ECALLayerDepth" value="3.0*mm" />
        <constant name="NLayersECAL" value="150" />
        <constant name="ECALStart" value="0.0*mm" />

        <constant name="ECALDepth" value="ECALLayerDepth*NLayersECAL" />
        
        <constant name="ECALPosX" value="0.0*mm" />
        <constant name="ECALPosY" value="0.0*mm" />
        <constant name="ECALPosZ" value="ECALStart + 0.5*ECALDepth" />

    </define>

    <detectors>
        <detector id="0" name="NA64Ecal" type="NA64ECal_base" readout="NA64EcalHits" vis="NA64Ecal">
            <dimensions x="ECALWidth" y="ECALHeight" z="ECALDepth"/>
            <position x="ECALPosX" y="ECALPosY" z="ECALPosZ"/>
        </detector>
    </detectors>

    <readouts>
        <readout name="NA64EcalHits">
        <id>layer:5,cell:5,x:-10,y:-10</id>
        </readout>
    </readouts>

</lccdd>
