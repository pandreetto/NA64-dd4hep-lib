<?xml version='1.0' encoding='utf-8'?>

<lccdd>
    <define>
        <constant name="StrawOuterRadius" value="5.0*mm" />
        <constant name="ShellThickness" value="0.05*mm" />
        <constant name="KaptonThickness" value="0.06195*mm" />
        <constant name="WireThickness" value="0.015*mm" />
    </define>

    <display>
        <vis name="StrawDefaultVis" alpha="1.0" r="0.0" g="0.0" b="0.0" showDaughters="true" visible="false"/>
        <vis name="StrawShellVis" alpha="1.0" r="1.0" g="0.0" b="0.0" showDaughters="true" visible="true"/>
        <vis name="StrawKaptonVis" alpha="1.0" r="0.0" g="0.0" b="1.0" showDaughters="true" visible="true"/>
        <vis name="StrawGasVis" alpha="1.0" r="0.0" g="1.0" b="0.0" showDaughters="true" visible="true"/>
        <vis name="StrawWireVis" alpha="0.5" r="0.8" g="0.2" b="0.0" showDaughters="true" visible="true"/>
    </display>

    <detectors>
        <detector id="0" name="NA64Straw" type="NA64Straw_base" readout="NA64StrawHits">
            <envelope vis="StrawDefaultVis">
                <shape type="Assembly"/>
            </envelope>

            <station id="0" length="200*mm" wires="32"
                     rotx="0.0*degree" roty="90.0*degree" rotz="0.0*degree"
                     posx="0.0*mm" posy="0.0*mm" posz="0.0*mm" />
            <station id="1" length="200*mm" wires="32"
                     rotx="90.0*degree" roty="0.0*degree" rotz="90.0*degree"
                     posx="0.0*mm" posy="0.0*mm" posz="20.0*mm" />
        </detector>
    </detectors>

    <readouts>
        <readout name="NA64StrawHits">
            <segmentation type="NoSegmentation" />
            <id>stationid:4,layerid:4,tubeid:24</id>
        </readout>
    </readouts>

</lccdd>
        